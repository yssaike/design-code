    "gap": "20px"
  },
  "tabs": {
    "borderRadius": "6px",
    "paddingX": "12px",
    "paddingY": "20px",
    "gap": "4px",
    "fontSize": "2px",
    "fontWeight": "12px"
  },
  "checkbox": {
    "borderRadius": "6px",
