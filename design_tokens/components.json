{
  "button": {
    "borderRadius": "6px",
    "paddingX": "12px",
    "paddingY": "16px",
    "shadow": "4px 2px 11px rgba(0,0,0,0.18)",
    "fontSize": "4px",
    "fontWeight": "12px",
    "gap": "16px"
  },
  "input": {
    "borderRadius": "4px",
    "paddingX": "4px",
    "paddingY": "24px",
    "borderWidth": "8px",
    "fontSize": "2px",
    "shadow": "1px 1px 20px rgba(0,0,0,0.11)"
  },
  "card": {
    "borderRadius": "16px",
    "padding": "8px",
    "shadow": "3px 7px 19px rgba(0,0,0,0.07)",
    "borderWidth": "1px",
    "gap": "16px"
  },
  "modal": {
    "borderRadius": "24px",
    "padding": "4px",
    "shadow": "0px 6px 23px rgba(0,0,0,0.05)",
    "maxWidth": "8px",
    "gap": "16px"
  },
  "tooltip": {
    "borderRadius": "12px",
    "paddingX": "24px",
    "paddingY": "8px",
    "shadow": "2px 3px 16px rgba(0,0,0,0.19)",
