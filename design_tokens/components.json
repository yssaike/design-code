{
  "button": {
    "borderRadius": "6px",
    "paddingX": "20px",
    "paddingY": "16px",
    "shadow": "4px 5px 8px rgba(0,0,0,0.06)",
    "fontSize": "4px",
    "fontWeight": "8px",
    "gap": "16px"
  },
  "input": {
    "borderRadius": "2px",
    "paddingX": "8px",
    "paddingY": "24px",
    "borderWidth": "8px",
    "fontSize": "4px",
    "shadow": "1px 1px 20px rgba(0,0,0,0.11)"
  },
  "card": {
    "borderRadius": "9999px",
    "padding": "8px",
    "shadow": "4px 8px 9px rgba(0,0,0,0.13)",
    "borderWidth": "8px",
    "gap": "12px"
  },
  "modal": {
    "borderRadius": "4px",
    "padding": "4px",
    "shadow": "4px 6px 4px rgba(0,0,0,0.06)",
    "maxWidth": "8px",
    "gap": "8px"
  },
  "tooltip": {
    "borderRadius": "9999px",
    "paddingX": "24px",
    "paddingY": "4px",
