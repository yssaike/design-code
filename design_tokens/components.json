{
  "button": {
    "borderRadius": "6px",
    "paddingX": "12px",
    "paddingY": "16px",
    "shadow": "4px 5px 8px rgba(0,0,0,0.06)",
    "fontSize": "4px",
    "fontWeight": "12px",
    "gap": "16px"
  },
  "input": {
    "borderRadius": "2px",
    "paddingX": "24px",
    "paddingY": "24px",
    "borderWidth": "8px",
    "fontSize": "8px",
