{
  "button": {
    "borderRadius": "16px",
    "paddingX": "4px",
    "paddingY": "16px",
    "shadow": "4px 1px 14px rgba(0,0,0,0.19)",
    "fontSize": "2px",
    "fontWeight": "8px",
    "gap": "4px"
  },
  "input": {
    "borderRadius": "16px",
    "paddingX": "4px",
    "paddingY": "16px",
    "borderWidth": "12px",
    "fontSize": "12px",
    "shadow": "2px 3px 4px rgba(0,0,0,0.12)"
  },
  "card": {
    "borderRadius": "8px",
    "padding": "4px",
    "shadow": "1px 5px 13px rgba(0,0,0,0.14)",
    "borderWidth": "2px",
    "gap": "20px"
  },
  "modal": {
    "borderRadius": "6px",
    "padding": "24px",
    "shadow": "0px 7px 12px rgba(0,0,0,0.16)",
    "maxWidth": "12px",
    "gap": "12px"
  },
  "tooltip": {
    "borderRadius": "2px",
    "paddingX": "8px",
    "paddingY": "20px",
    "shadow": "3px 3px 6px rgba(0,0,0,0.07)",
    "fontSize": "8px"
  },
  "badge": {
    "borderRadius": "8px",
    "paddingX": "20px",
    "paddingY": "8px",
    "fontSize": "4px",
    "fontWeight": "1px"
  },
  "avatar": {
    "borderRadius": "24px",
    "borderWidth": "4px",
    "shadow": "1px 2px 12px rgba(0,0,0,0.08)",
    "size": "12px"
  },
  "dropdown": {
    "borderRadius": "6px",
    "padding": "4px",
    "shadow": "1px 6px 12px rgba(0,0,0,0.13)",
    "itemPadding": "8px",
    "gap": "12px"
  },
  "tabs": {
    "borderRadius": "4px",
    "paddingX": "16px",
    "paddingY": "16px",
    "gap": "12px",
    "fontSize": "12px",
    "fontWeight": "8px"
  },
  "checkbox": {
    "borderRadius": "9999px",
    "size": "8px",
    "borderWidth": "4px",
    "gap": "16px"
  }
