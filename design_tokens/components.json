{
  "button": {
    "borderRadius": "6px",
    "paddingX": "16px",
    "paddingY": "16px",
    "shadow": "4px 2px 11px rgba(0,0,0,0.18)",
    "fontSize": "4px",
    "fontWeight": "12px",
    "gap": "16px"
  },
  "input": {
    "borderRadius": "4px",
    "paddingX": "4px",
    "paddingY": "20px",
    "borderWidth": "16px",
    "fontSize": "12px",
    "shadow": "0px 3px 19px rgba(0,0,0,0.11)"
  },
  "card": {
    "borderRadius": "9999px",
    "padding": "8px",
    "shadow": "0px 3px 6px rgba(0,0,0,0.18)",
    "borderWidth": "16px",
    "gap": "24px"
  },
  "modal": {
    "borderRadius": "9999px",
    "padding": "4px",
    "shadow": "0px 1px 23px rgba(0,0,0,0.11)",
    "maxWidth": "8px",
    "gap": "24px"
  },
  "tooltip": {
    "borderRadius": "24px",
    "paddingX": "12px",
    "paddingY": "24px",
    "shadow": "1px 3px 6px rgba(0,0,0,0.16)",
    "fontSize": "12px"
  },
  "badge": {
    "borderRadius": "6px",
    "paddingX": "4px",
    "paddingY": "12px",
    "fontSize": "4px",
    "fontWeight": "1px"
  },
  "avatar": {
    "borderRadius": "8px",
    "borderWidth": "1px",
    "shadow": "2px 4px 22px rgba(0,0,0,0.09)",
    "size": "1px"
  },
  "dropdown": {
    "borderRadius": "4px",
    "padding": "24px",
    "shadow": "4px 2px 19px rgba(0,0,0,0.04)",
    "itemPadding": "16px",
    "gap": "8px"
  },
  "tabs": {
    "borderRadius": "24px",
    "paddingX": "12px",
    "paddingY": "20px",
    "gap": "12px",
    "fontSize": "2px",
    "fontWeight": "4px"
  },
  "checkbox": {
    "borderRadius": "4px",
    "size": "2px",
    "borderWidth": "1px",
    "gap": "20px"
  }
